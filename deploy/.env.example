# Biến môi trường mà robot-core và HMI đọc, tiền tố EV_ARM_ theo định danh ứng dụng ev-arm (ADR 0007).
# Giá trị ghi ở đây là giá trị dùng khi biến không được đặt.

# Thư mục cấu hình trạm và tài khoản người dùng (users.json); trong container là volume ev-arm-config.
EV_ARM_CONFIG_DIR=/var/lib/ev-arm/config
# Thư mục bản ghi MCAP; trong container là volume ev-arm-recordings.
EV_ARM_RECORDINGS_DIR=/var/lib/ev-arm/recordings
# Địa chỉ và cổng TCP mà lệnh `robot-core serve` nghe (REQ-CLI-001).
EV_ARM_HOST=127.0.0.1
EV_ARM_PORT=8000

# Địa chỉ của core mà proxy của HMI chuyển /api tới, cả REST lẫn WSS: proxy của Vite khi chạy `pnpm --filter operator-ui run dev` (REQ-HMI-012), mặc định như dưới, và Caddy trong image hmi, mặc định http://core:8000.
EV_ARM_CORE_URL=http://127.0.0.1:8000
